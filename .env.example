# SomaiyaNet -- copy to .env and fill in. .env is gitignored.

# Superuser connection, used only by scripts/setup_db.py and tests
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change_me
PGDATABASE=somaiyanet
TEST_PGDATABASE=somaiyanet_test

# Login passwords for the application roles created by db/07_security.sql.
# Throwaway defaults for a local, disposable database only.
MISSION_DIRECTOR_PASSWORD=director123
STATION_BOM_PASSWORD=bom123
STATION_HEL_PASSWORD=hel123
STUDENT_ANALYST_PASSWORD=student123
AI_ROUTER_PASSWORD=router123

# Backend session signing key
SESSION_SECRET=dev-only-change-me
